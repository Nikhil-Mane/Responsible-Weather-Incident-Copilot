# Copy to .env and fill in. Never commit .env.
# Leave Azure values empty to run the deterministic offline path.

COPILOT_ENV=dev
COPILOT_LOG_LEVEL=INFO
COPILOT_LOG_JSON=true
COPILOT_DATA_DIR=data
COPILOT_GENERATED_DIR=data/generated
COPILOT_STATE_DIR=var

# Who drafts actions and alerts: auto (LCEL if Azure is configured, else rules), rules, lcel, crew
COPILOT_DRAFTER=auto

# Secret used to sign approval tokens (required outside tests; use a long random value)
COPILOT_APPROVAL_SECRET=
COPILOT_APPROVAL_TTL_SECONDS=900

# Input limits
COPILOT_MAX_INPUT_BYTES=262144
COPILOT_MAX_JSON_DEPTH=12

# Data quality
COPILOT_MAX_OBSERVATION_AGE_MINUTES=60
COPILOT_MIN_SOURCE_CONFIDENCE=0.7
COPILOT_MAX_FORECAST_HORIZON_HOURS=48

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
# An Azure *API* version such as 2024-10-21. Not the model version (for example 2025-04-14), which
# makes every call return 404 and silently falls back to the rule-based drafter.
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
COPILOT_LLM_TIMEOUT_SECONDS=30
COPILOT_LLM_MAX_RETRIES=3
# Price per 1,000 tokens in your currency, used only for the eval cost estimate (0 = unknown)
COPILOT_LLM_PRICE_INPUT_PER_1K=0
COPILOT_LLM_PRICE_OUTPUT_PER_1K=0

# Langfuse (optional). Traces include prompts and model outputs, so use a project you trust with
# incident data. LANGFUSE_HOST is your region's URL, e.g. https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
